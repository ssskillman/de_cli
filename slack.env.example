# Copy to ~/.config/de/slack.env and fill in values (never commit the real file).
#
# Required: bot or user token with channels:history (and groups:history if private).
# The app/bot must be invited to the channel (default C01V64XA4AK).

SLACK_BOT_TOKEN=xoxb-replace-me
# Optional if team.info is unavailable:
# SLACK_TEAM_DOMAIN=yourworkspace
